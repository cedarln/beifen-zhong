<?xml version="1.0" encoding="utf-8"?>
<!--
  权限清单即隐私宣言。
  《正在备份》的设定是"她只存在于这台手机的本地缓存里"，所以 v0.1.0 整包不申请网络权限。
  v0.1.1 起玩家要求"应用内下载并更新，不要跳浏览器"，于是 `INTERNET` 进来了——
  这是**唯一一个**例外，而且它的边界是代码级守着的，不是写在注释里自我表扬：
    · 全工程只有 `update/UpdateChecker.kt` 允许出现网络 API，
      越界由 `NetworkBoundaryTest` 直接判失败（它扫源码，不靠人记得）；
    · 它只在玩家按下设置页「检查更新」那一刻动一次：没有启动时自动检查、没有后台轮询、
      不进 GameViewModel、不进引擎、不在 WakeReceiver / CatchUpWorker 的任何一条路径上；
    · 它查的是我们自己的发布页。小满说的话、她知道的东西，一个字都不从网络回来——
      剧本仍然只来自 `script/*.json`（`StoryEngine` 第一条铁律）。
  一句话：上网的是"你下楼取东西"这件事，不是她。
  也不申请 READ_NOTIFICATIONS / 无障碍 / 通讯录：小满能感知的一切
  都来自 docs/01 感知映射表里那些合法设备信号（前台、灭屏、省电、电量、日期）。

  诚实条：装完包后 `aapt2 dump badging` 会额外看到四条我们没写的权限——
  WAKE_LOCK / ACCESS_NETWORK_STATE / FOREGROUND_SERVICE 由 androidx.work:work-runtime
  的清单合并进来（重启补投靠它），第四条 `cn.linan.backingup.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION`
  是 androidx.core 给"运行期注册的接收器"自动加的**自定义签名级**权限，只发给这个包自己，
  不给外部 App 任何能力。ACCESS_NETWORK_STATE 只是"能不能读到网络连接状态"，
  它不给任何出网能力；我们的代码从未查询它，WorkManager 也没给我们的任务加网络约束。
  想删干净得验证补投链路，v0.1.1 不动它，先把话说在这儿。
  （反过来，原来这里还写着 VIBRATE——代码里一次都没调用过震动，而界面承诺"不响铃、不震动"，
  所以删了：一条用不上的权限不是"以防万一"，是对那句承诺的伪造。）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- D1 的授权引导：她那句"你给了我一个能叫醒你的权利" -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 只申请 SCHEDULE_EXACT_ALARM（用户可在系统设置里撤），**不**申请 USE_EXACT_ALARM：
         一是商店政策只放行时钟/日历类 App 用它，二是它一旦声明就无条件生效，
         d1_n140 那个"你给了我一个能叫醒你的权利"的授权分支会当场变成假动作——
         剧情里她请求的东西，代码里必须真的可能被拒绝。
         降级路径（这台设备把精确唤醒撤了）写在 ReminderScheduler.schedule()：
         那时改用 setAndAllowWhileIdle——它不要精确权限，到点照样醒，只是不保证准时。
         她可能迟到，不是她的问题。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 22 小时等待要跨 Doze。这是引导用户去设置里点一下的权限，不申请就静默失效 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 重启后 catchUp()：逾期不补投 = 玩家以为游戏坏了 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 应用内更新：只给 update/UpdateChecker.kt 用（NetworkBoundaryTest 守这条边界）。
         剧情层、引擎、唤醒链路一律不许引用网络——见文件顶部那三条。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 更新包下完之后拉起系统安装器。侧载分发的必然代价，商店包不该带这条。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.BackingUp"
        tools:targetApi="34">

        <!-- 应用内更新：DownloadManager 把更新包下到 getExternalFilesDir/update/，
             经这里授权给系统安装器。exported=false + grantUriPermissions=true：
             安装器只能拿到我们当场递给它的那一条 URI，拿不到目录。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 冷启动与开机后各做一次补投，见 docs/04 第四节。
             不声明 LOCKED_BOOT_COMPLETED：那要求 directBootAware + 设备加密存储，
             而存档在凭据加密区里，解锁之前读不到——写上只会得到一个永远不来的承诺。 -->
        <receiver
            android:name=".sched.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 闹钟的落点。只由自己的 PendingIntent.getBroadcast 触发，
             所以 exported=false：别的 App 伪造不了"她来找你了"。 -->
        <receiver
            android:name=".sched.WakeReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
