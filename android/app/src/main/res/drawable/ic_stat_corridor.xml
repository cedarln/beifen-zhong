<?xml version="1.0" encoding="utf-8"?>
<!--
  状态栏小图标：307 那扇虚掩的门，门缝底下漏出一条光。
  通知小图标必须是单色 silhouette（系统会按深浅色主题重着色），
  所以这里只有 #FFFFFFFF 一种颜色，其余全靠形状。
  不能拿 @mipmap/ic_launcher 顶替：自适应图标当小图标会被裁成一团白。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 门框：左柱细、右柱粗，门是斜着没关严的 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5,2 L19,2 A1,1 0 0 1 20,3 L20,21 L15,21 L15,3 L6,3 L6,21 L4,21 L4,3 A1,1 0 0 1 5,2 Z" />
    <!-- 门把手 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.6,10.6 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0" />
    <!-- 门缝底下那点光：越往里越窄 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.4,17.2 L13.4,15.4 L13.4,17.4 L7.4,19.2 Z" />
</vector>
